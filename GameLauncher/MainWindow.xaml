<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d" Title="FFReStart Launcher" Width="1100" Height="680"
        MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBrush}" ContentRendered="Window_ContentRendered" Closed="Window_Closed">
    <Grid ClipToBounds="True">
        <Image Source="images/newloginbackground.png" Stretch="UniformToFill" Opacity="0.92"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#10051220" Offset="0"/>
                    <GradientStop Color="#BB06111D" Offset="0.53"/>
                    <GradientStop Color="#F706111D" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Canvas IsHitTestVisible="False" Opacity="0.7">
            <Polyline Points="0,88 235,88 257,110 470,110" Stroke="{StaticResource CyanBrush}" StrokeThickness="1"/>
            <Polyline Points="1100,544 910,544 888,522 720,522" Stroke="{StaticResource NanoGreenBrush}" StrokeThickness="1"/>
            <Rectangle Canvas.Left="24" Canvas.Top="105" Width="6" Height="42" Fill="{StaticResource NanoGreenBrush}"/>
        </Canvas>

        <Grid Margin="40,30,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="images/ReStartTransparentLogo.png" Width="72" Height="72" Stretch="Uniform"
                           automation:AutomationProperties.Name="FFReStart logo"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FFReSTART" FontFamily="{StaticResource DisplayFont}" FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock Text="FUSIONFALL COMMUNITY LAUNCHER" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{StaticResource CyanBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="MusicControlPanel" Background="#B8102636" BorderBrush="#624FA3B8"
                            BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="0,0,10,0"
                            automation:AutomationProperties.Name="Launcher music controls">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="1,0,1,5">
                                <TextBlock Text="MUSIC" FontFamily="{StaticResource DisplayFont}" FontSize="10"
                                           Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MusicVolumeText" DockPanel.Dock="Right" Text="35%"
                                           Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MuteMusicButton" Content="_MUTE" Click="MuteMusicButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" FontSize="10"
                                        Margin="0,0,9,0" ToolTip="Mute launcher music"
                                        automation:AutomationProperties.Name="Mute launcher music"/>
                                <Slider x:Name="MusicVolumeSlider" Width="92" Minimum="0" Maximum="100"
                                        TickFrequency="5" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                        Foreground="{StaticResource CyanBrush}" ValueChanged="MusicVolumeSlider_ValueChanged"
                                        ToolTip="Launcher music volume" FocusVisualStyle="{StaticResource LauncherFocusVisual}"
                                        automation:AutomationProperties.Name="Launcher music volume"
                                        automation:AutomationProperties.HelpText="Use the arrow keys to adjust launcher music volume"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="AccountStatusHost" VerticalAlignment="Center"
                                automation:AutomationProperties.Name="Player account status">
                    <Border Background="#B8102636" BorderBrush="#624FA3B8" BorderThickness="1" CornerRadius="8" Padding="13,9">
                        <Grid>
                            <StackPanel x:Name="GuestAccountHeader" Orientation="Horizontal">
                                <Border Width="28" Height="28" Background="#2431D8FF" CornerRadius="14" Margin="0,0,9,0">
                                    <TextBlock Text="◎" Foreground="{StaticResource CyanBrush}" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="GUEST PILOT" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sign in below to launch" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="SignedInAccountHeader" Orientation="Horizontal" Visibility="Collapsed">
                                <StackPanel Margin="0,0,13,0">
                                    <TextBlock x:Name="SignedInUsernameText" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <TextBlock Text="SESSION READY" Foreground="{StaticResource NanoGreenBrush}"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="10" TextAlignment="Right"/>
                                </StackPanel>
                                <Button Content="SIGN _OUT" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="LogoutButton_Click" Padding="10,7"
                                        automation:AutomationProperties.Name="Sign out of the launcher"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </ContentControl>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*" MinWidth="390"/><ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="0.82*" MinWidth="340"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Image Source="images/FFReStartMenuBG.png" Stretch="Uniform" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" MaxHeight="515" Opacity="0.9"
                           automation:AutomationProperties.Name="FusionFall heroes"/>
                    <StackPanel VerticalAlignment="Top" Margin="4,22,60,0">
                        <Border Background="{StaticResource NanoGreenBrush}" CornerRadius="3" Padding="9,4" HorizontalAlignment="Left">
                            <TextBlock Text="WELCOME BACK, HERO" Foreground="#FF071408" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock Margin="0,12,0,0" Text="THE FIGHT FOR THE FUTURE STARTS HERE"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="30" LineHeight="31"
                                   TextWrapping="Wrap" MaxWidth="390" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border x:Name="AuthenticationPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Width="365" Margin="4,0,0,7" Padding="18,16" CornerRadius="10"
                            Background="#F00A1928" BorderBrush="#824FA3B8" BorderThickness="1">
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="PILOT AUTHORIZATION" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="SIGN IN TO DEPLOY" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="Bold" Margin="0,2,0,10"/>
                            <TextBox x:Name="UsernameTextBox" Height="34" Padding="9,6" Margin="0,0,0,8"
                                     ToolTip="Local game account username" KeyDown="LoginField_KeyDown"
                                     automation:AutomationProperties.Name="Username"/>
                            <PasswordBox x:Name="PasswordInput" Height="34" Padding="9,6" Margin="0,0,0,8"
                                         ToolTip="Local game account password" KeyDown="LoginField_KeyDown"
                                         automation:AutomationProperties.Name="Password"/>
                            <CheckBox x:Name="RememberSessionCheckBox" Content="Remember Password" IsChecked="False"
                                      Unchecked="RememberSessionCheckBox_Unchecked" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Remembers a Windows-protected session, never your password."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="20,2,0,8"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AuthStatusText" Foreground="#FFFFD27D" FontSize="11" MinHeight="16"
                                       TextWrapping="Wrap" Margin="0,0,0,7"
                                       automation:AutomationProperties.LiveSetting="Assertive"/>
                            <Button x:Name="LoginButton" Content="SIGN _IN" Click="LoginButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#6C4BA7BA"
                        BorderThickness="1" CornerRadius="12" Padding="25,23" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect Color="#FF000000" BlurRadius="28" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="MISSION CONTROL" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                           Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="GAME STATUS" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#1F65F43D" BorderBrush="#5565F43D"
                                    BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Top">
                                <TextBlock x:Name="VersionText" Text="—" Foreground="{StaticResource NanoGreenBrush}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                           automation:AutomationProperties.Name="Installed game version"/>
                            </Border>
                        </DockPanel>
                        <Border Grid.Row="1" Margin="0,18,0,0" Background="{StaticResource PanelRaisedBrush}"
                                BorderBrush="#304EA4B8" BorderThickness="1" CornerRadius="8" Padding="15,13">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource CyanBrush}" Margin="0,4,12,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="StatusTitleText" Text="CHECKING GAME FILES" FontFamily="{StaticResource DisplayFont}"
                                               FontWeight="Bold" FontSize="15" automation:AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="StatusDetailText" Text="Contacting the update service…"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,3,0,0" MinHeight="32" automation:AutomationProperties.LiveSetting="Polite"/>
                                    <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,11,0,0" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource NanoGreenBrush}" Background="#FF07111A"
                                                 BorderThickness="0" automation:AutomationProperties.Name="Download progress"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button x:Name="PlayButton" Grid.Row="2" Margin="0,17,0,0" Content="CHECKING…"
                                Style="{StaticResource PrimaryButtonStyle}" Click="PlayButton_Click" IsEnabled="False"
                                IsDefault="True" MinHeight="62"
                                automation:AutomationProperties.HelpText="Launch the installed game or retry a failed update"/>
                        <Grid Grid.Row="3" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="_DISCORD" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DiscordButton_Click" ToolTip="Open the FFReStart community Discord in your browser"
                                    automation:AutomationProperties.Name="Join FFReStart community Discord"/>
                            <Button Grid.Column="2" Content="_SUPPORT" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SupportButton_Click" ToolTip="Open the FFReStart support Discord in your browser"
                                    automation:AutomationProperties.Name="Open FFReStart support"/>
                            <Button Grid.Column="4" Content="GAME _FILES" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="GameFilesButton_Click" ToolTip="Open the local FFReStart installation folder"
                                    automation:AutomationProperties.Name="Open installed game files"/>
                        </Grid>
                        <Border Grid.Row="4" Height="1" Background="#354EA4B8" Margin="0,20,0,14"/>
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INSTALL FOLDER" Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="10"/>
                                <TextBlock x:Name="InstallPathText" TextTrimming="CharacterEllipsis" FontSize="11"
                                           Foreground="#FFD4E1E8" Margin="0,3,12,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ResetInstallLocationButton" Content="DEFAULT" Click="ResetInstallLocationButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" FontSize="10" Margin="0,0,6,0"
                                        ToolTip="Restore the LocalAppData install folder"
                                        automation:AutomationProperties.Name="Restore default FFReStart install folder"/>
                                <Button x:Name="InstallLocationButton" Content="CHANGE" Click="InstallLocationButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" FontSize="10"
                                        ToolTip="Choose where FFReStart is installed and updated"
                                        automation:AutomationProperties.Name="Change FFReStart install folder"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
